 .voice-greeting{border-left:2px solid #a48b5d;padding-left:14px;margin-top:18px;font-style:italic}
+.cloud-entry{margin-top:16px;min-height:44px}.cloud-title-status{font-size:.75rem;line-height:1.5;color:#e4d7bd;margin:0 0 12px;max-width:34rem}.cloud-hud{max-width:245px;text-align:right;min-height:44px}.cloud-hud .save-status{font-size:.71rem;line-height:1.5;white-space:normal}
+.cloud-slots,.cloud-history{display:grid;gap:10px;margin:18px 0}.cloud-slot{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px;border:1px solid #a98e5a60;border-radius:9px;background:#a7905a08;min-width:0}.cloud-slot.active{border-color:#758967;background:#7e947910}.cloud-slot p{margin:4px 0!important;font-size:.86rem}.cloud-slot small{display:block;font-size:.72rem;opacity:.75}.cloud-slot button{flex-shrink:0}.cloud-actions{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}.cloud-profile{margin:15px 0}.cloud-profile>div{display:flex;gap:10px;margin-top:8px}.cloud-profile input,#cloud-erase{min-width:0;width:100%;padding:11px;border:1px solid #9b855955;border-radius:6px;background:#fff9;color:#24332b;font:inherit}.cloud-conflict{padding:16px;margin:18px 0;border:1px solid #ba7838;border-radius:8px;background:#bd783b12}.cloud-conflict button{margin:4px}.cloud-privacy,.cloud-copies{margin-top:18px;font-size:.83rem;line-height:1.7}.cloud-privacy summary,.cloud-copies summary{cursor:pointer;min-height:32px}.cloud-privacy p,.cloud-copies p{font-size:.83rem!important}html[data-cloud=conflict] #save-status,html[data-cloud=error] #save-status{color:#e9b86c}
+@media(max-width:600px){.cloud-slot{align-items:stretch;flex-direction:column}.cloud-slot button{width:100%}.cloud-actions{flex-direction:column}.cloud-actions button{width:100%}.cloud-profile>div{flex-direction:column}.cloud-hud{max-width:160px}.cloud-title-status{font-size:.69rem}.cloud-conflict button{width:100%;margin:5px 0}}
 .audio-caption{position:absolute;z-index:25;bottom:156px;left:50%;transform:translateX(-50%);width:max-content;max-width:min(680px,88%);padding:9px 15px;border-radius:8px;background:#101b18e8;color:#f7eddb;font-size:.86rem;line-height:1.65;pointer-events:none;text-align:center}
 .audio-caption[hidden]{display:none}
 .audio-settings{margin:20px 0;padding:14px 18px;border:1px solid #b59b6d55;border-radius:10px;min-width:0}
