    "test:build-output": "node test/build-output.cjs",
    "pretest": "npm run check:agents",
    "prebuild": "npm run check:agents",
    "test": "node tools/run-checks.cjs test",
    "test:q01-state": "node test/q01-state.cjs",
    "test:q01-greybox": "node test/q01-greybox.cjs",
    "test:q01-greybox-browser": "node test/q01-greybox-browser.mjs",
    "test:browser": "node tools/run-checks.cjs browser",
    "test:craft-details": "node tools/run-checks.cjs craft-details",
    "test:graphics": "node test/graphics-browser.mjs",
    "test:character": "node test/char-fidelity.mjs",
    "test:kit-budget": "node test/kit-budget.cjs",
    "build:kit": "node tools/run-checks.cjs kit",
    "build": "node tools/run-checks.cjs build",
    "dev": "node tools/serve.cjs",
    "setup:kit": "npm ci --prefix tools/environment-kit && node tools/environment-kit/setup-encoder.mjs",
    "test:kit-cache": "node test/kit-cache.cjs",
    "test:kit-lifecycle": "node test/kit-lifecycle-browser.mjs",
    "test:kit-profile": "node test/kit-profile-browser.mjs",
